// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  MEDICAL_USER
  VALIDATOR
  ADMIN
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  VALIDATION
  SYSTEM
}

// User Model - All system users
model User {
  id              String        @id @default(uuid())
  fullName        String
  email           String        @unique
  password        String
  role            UserRole
  specialization  String?
  institution     String?
  profileImage    String?
  isEmailVerified Boolean       @default(false)
  accountStatus   AccountStatus @default(ACTIVE)
  refreshToken  String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  questions       Question[]
  validations     ValidationReview[]
  sessions        Session[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  medicalDocuments MedicalDocument[]
}

// Medical Questions
model Question {
  id           String     @id @default(uuid())
  userId       String
  questionText String     @db.Text
  isSaved      Boolean    @default(false)

  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id])
  aiResponse   AIResponse?
}

// AI Generated Responses
model AIResponse {
  id              String           @id @default(uuid())
  questionId      String           @unique
  summary         String           @db.Text
  keyFindings     String[]         @default([])
  confidenceScore Float?
  validationStatus ValidationStatus @default(PENDING)
  generatedBy     String           @default("GPT-4o")

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  question        Question         @relation(fields: [questionId], references: [id])
  citations       Citation[]
  validations     ValidationReview[]
  feedbacks       Feedback[]
}

// Evidence Citations
model Citation {
  id              String   @id @default(uuid())
  aiResponseId    String
  title           String
  source          String
  authors         String?
  publicationYear Int?
  doi             String?
  url             String?
  citationIndex   Int

  documentType    String?
  specialty       String?

  chunkId         String?
  pageNumber      Int?
  sectionTitle    String?

  createdAt       DateTime @default(now())

  aiResponse      AIResponse @relation(fields: [aiResponseId], references: [id])
}

// Validation Reviews
model ValidationReview {
  id         String          @id @default(uuid())
  aiResponseId String
  validatorId String
  status     ValidationStatus
  score      Int?
  feedback   String?         @db.Text
  reviewedAt DateTime        @default(now())

  aiResponse AIResponse      @relation(fields: [aiResponseId], references: [id])
  validator  User            @relation(fields: [validatorId], references: [id])
}

enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Medical Documents for RAG
model MedicalDocument {
  id              String           @id @default(uuid())
  title           String
  description     String?
  fileName        String
  fileUrl         String
  fileType        String
  fileSize        Int
  specialty       String?
  documentType    String?
  source          String?
  publicationYear Int?
  uploadedById    String
  uploadedBy      User @relation(fields: [uploadedById], references: [id])
  ingestionStatus IngestionStatus @default(PENDING)
  isVerified      Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  embeddingMetadata EmbeddingMetadata[]
}

// Pinecone Vector References
model EmbeddingMetadata {
  id              String @id @default(uuid())
  documentId      String
  pineconeVectorId String @unique
  chunkIndex      Int
  chunkText       String @db.Text

  createdAt       DateTime @default(now())

  document MedicalDocument @relation(fields: [documentId], references: [id])
}

// Notifications
model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)

  user      User     @relation(fields: [userId], references: [id])
  metadata  Json?

  createdAt DateTime @default(now())
}

// JWT Sessions
model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime

  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
}

// Audit Logs
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?

  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

// Feedback
model Feedback {
  id          String @id @default(uuid())
  aiResponseId String
  comment     String @db.Text

  createdAt   DateTime @default(now())

  aiResponse  AIResponse @relation(fields: [aiResponseId], references: [id])
}

// Email Logs
enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailLog {
  id        String       @id @default(uuid())
  recipient String
  subject   String
  status    EmailStatus  @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())
}