# PostgreSQL database
DATABASE_URL="postgresql://user:password@localhost:5432/nileopedia"

# JWT
JWT_ACCESS_SECRET="your-jwt-access-secret-key"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Pinecone
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="your-pinecone-environment"
PINECONE_INDEX_NAME="nileopedia-medical"

# Groq (for chat completions)
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# Hugging Face (for embeddings)
HF_API_KEY="your-hf-api-key"
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Redis
REDIS_URL="redis://localhost:6379"

# Email
EMAIL_PROVIDER="resend"
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@nileopedia.com"
FRONTEND_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Session
SESSION_SECRET="your-session-secret"

# App
PORT=3001
NODE_ENV="development"

# Mock AI (set to true to enable mock responses when AI service unavailable)
USE_MOCK_AI="true"

# Mock Embeddings (set to true to use mock embeddings instead of HF)
USE_MOCK_EMBEDDINGS="true"