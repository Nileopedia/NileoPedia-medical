DATABASE_URL="postgresql://postgres:password@localhost:5432/nileopedia_test"

# JWT
JWT_ACCESS_SECRET="test-access-secret-key"
JWT_REFRESH_SECRET="test-refresh-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Pinecone (mock values for testing)
PINECONE_API_KEY="test-pinecone-api-key"
PINECONE_ENVIRONMENT="test"
PINECONE_INDEX_NAME="nileopedia-test"

# Groq (mock values)
GROQ_API_KEY="test-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# Hugging Face (mock values)
HF_API_KEY="test-hf-api-key"
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Redis
REDIS_URL="redis://localhost:6379"

# Email (Resend)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="test-resend-api-key"
EMAIL_FROM="test@nileopedia.com"

# Test settings
NODE_ENV="test"
PORT=3002
USE_MOCK_AI="true"
USE_MOCK_EMBEDDINGS="true"