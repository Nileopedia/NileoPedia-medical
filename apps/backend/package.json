{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "ts-node-dev --respawn --transpile-only src/jobs/worker.ts",
    "lint": "eslint src --ext .ts",
    "test": "NODE_ENV=test jest",
    "test:watch": "jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:e2e": "NODE_ENV=test jest --config jest.e2e.config.js",
    "test:prisma": "NODE_ENV=test jest tests/integration/prisma --testTimeout=30000",
    "test:integration": "NODE_ENV=test jest tests/integration --testTimeout=30000",
    "test:routes": "NODE_ENV=test jest tests/integration/routes --testTimeout=30000",
    "test:workers": "NODE_ENV=test jest tests/integration/workers --testTimeout=30000",
    "test:external": "NODE_ENV=development jest tests/integration/external --testTimeout=60000",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "reindex-documents": "ts-node src/scripts/reindex-documents.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^2.0.0",
    "@prisma/client": "^5.22.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.6",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "generate": "^0.14.0",
    "google-auth-library": "^10.6.2",
    "groq-sdk": "^0.7.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "npx": "^10.2.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.21.0",
    "redis": "^4.6.0",
    "resend": "^6.12.4",
    "socket.io": "^4.7.2",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^6.0.0",
    "@types/express-validator": "^3.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.5-lts.1",
    "@types/node": "^20.8.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/redis": "^4.0.6",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^2.0.0",
    "@types/winston": "^2.4.4",
    "eslint": "^8.50.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "jest": "^29.6.0",
    "node-fetch": "2",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}