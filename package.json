{
  "name": "nileopedia-monorepo",
  "version": "1.0.0",
  "description": "NileoPedia - AI-Powered Medical Knowledge Platform Monorepo",
  "private": true,
  "packageManager": "pnpm@8.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --no-daemon",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "mock-server": "node mock-server/server.cjs",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "path-key": "^4.0.0",
    "shebang-command": "^2.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "ts-node": "^10.9.2",
    "turbo": "^1.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}